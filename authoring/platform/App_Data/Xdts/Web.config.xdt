<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
    <system.webServer>
      <modules runAllManagedModulesForAllRequests="true">
        <add type="Sitecore.Support.NonceCookieTrackerHttpModule, NonceCookieTracker" name="NonceCookieTrackerHttpModule"  xdt:Transform="Insert"/>
      </modules>
    </system.webServer>
</configuration>
